// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Users & Auth ---

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  activated     Boolean   @default(false)
  langKey       String?
  imageUrl      String?
  activationKey String?
  resetKey      String?
  resetDate     DateTime?
  
  // Contact Info
  phone         String?
  landline      String? // Fixed phone
  address       String? // Full address text
  
  // Personal Info (Particulier)
  civility      Civility?
  dateOfBirth   DateTime?

  // Company / Professional Info
  userType      UserType  @default(PARTICULIER)
  companyName   String?
  companyActivity CompanyActivity?
  commercialRegister String?
  nif                String? // Numéro d'Identification Fiscale
  nis                String? // Numéro d'Identification Statistique

  // Documents (Société)
  rcDocumentUrl      String?
  agreementDocumentUrl String?
  nifDocumentUrl     String?
  nisDocumentUrl     String?
  inapiDocumentUrl   String? // Justificatif de dépôt INAPI (si le nom de marque n'apparaît pas sur le RC)
  agencyLogoUrl      String?
  position           String?

  // Conformité & statut de compte
  agreementExpiryDate DateTime? // Désactivation automatique des services pro à cette date
  adminVerified Boolean   @default(false)
  accountStatus AccountStatus @default(ACTIVE)
  statusReason  String?
  lastLoginAt   DateTime?

  townId        Int?
  town          Town?     @relation(fields: [townId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  announces     Announce[]
  entrustedResearch EntrustedResearch[]
  points        UserPoint?
  pointUsages   PointUsage[]
  pointPurchases PointPurchase[]
  boutiqueSubscriptions BoutiqueSubscription[]
  favorites     Favorite[]
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  boutiqueFollowing BoutiqueFollow[] @relation("BoutiqueFollower")
  boutiqueFollowers BoutiqueFollow[] @relation("BoutiqueOwner")
  contactClicks     ContactClick[]   @relation("ContactClickOwner")
  reportsReceived   Report[]         @relation("ReportedOwner")
  reportsMade       Report[]         @relation("Reporter")
  announceViews     AnnounceView[]   @relation("AnnounceViewOwner")
  notifications     Notification[]

  @@map("user")
}

// Abonnement d'un visiteur à la boutique publique d'un professionnel (bouton "S'abonner").
// Compteur réel affiché sur la boutique, et matière première pour les statistiques du pro.
model BoutiqueFollow {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  followerId Int
  follower   User     @relation("BoutiqueFollower", fields: [followerId], references: [id], onDelete: Cascade)

  ownerId    Int
  owner      User     @relation("BoutiqueOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([followerId, ownerId])
  @@map("boutique_follow")
}

model UserPoint {
  id             Int      @id @default(autoincrement())
  currentPoints  Int      @default(0)
  expirationDate DateTime?
  
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_point")
}

model PointUsage {
  id         Int      @id @default(autoincrement())
  pointsUsed Int
  usageDate  DateTime @default(now())
  action     String   @default("BOOST") // BOOST | FEATURE

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  @@map("point_usage")
}

model PointPurchase {
  id          Int       @id @default(autoincrement())
  pack        String    // PACK_50 | PACK_100 | PACK_200
  points      Int       // 50 | 100 | 200
  price       Int       // 1500 | 2500 | 3500
  status      String    @default("PENDING") // PENDING | VALIDATED | REJECTED
  createdAt   DateTime  @default(now())
  validatedAt DateTime?

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_purchase")
}

model BoutiqueSubscription {
  id             Int       @id @default(autoincrement())
  pack           String    // STANDARD | AVANCEE | ENTREPRISE
  price          Int       // 5000 | 10000 | 15000
  pointsIncluded Int       // 50 | 100 | 200
  status         String    @default("PENDING") // PENDING | VALIDATED | REJECTED
  createdAt      DateTime  @default(now())
  validatedAt    DateTime?
  expiresAt      DateTime? // date d'expiration des points (1 mois)

  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("boutique_subscription")
}

// Offres "Points" et "Boutique" — modifiables par l'administrateur (titre, description,
// prix, points attribués). "key" est l'identifiant stable référencé par PointPurchase.pack
// / BoutiqueSubscription.pack (PACK_50, PACK_100, PACK_200, STANDARD, AVANCEE, ENTREPRISE) :
// il ne doit jamais changer, seuls title/description/price/points sont éditables.
model OfferPack {
  id          Int           @id @default(autoincrement())
  kind        OfferPackKind
  key         String
  title       String
  description String?       @db.Text
  price       Int
  points      Int
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([kind, key])
  @@map("offer_pack")
}

enum OfferPackKind {
  POINTS
  BOUTIQUE
}

// --- Locations (City / Town / Address) ---

model City {
  id      Int    @id @default(autoincrement())
  nameAr  String
  nameEn  String
  nameFr  String
  code    Int?   @unique
  
  towns   Town[]

  @@map("city")
}

model Town {
  id      Int    @id @default(autoincrement())
  nameAr  String
  nameEn  String
  nameFr  String
  code    Int?   @unique
  
  cityId  Int
  city    City   @relation(fields: [cityId], references: [id])
  
  addresses Address[]
  users     User[]

  @@map("town")
}

model Address {
  id      Int    @id @default(autoincrement())
  street  String // mapped from 'adress' in Java
  
  townId  Int
  town    Town   @relation(fields: [townId], references: [id])

  property Property?

  @@map("address")
}

// --- Real Estate Core ---

model Announce {
  id              Int       @id @default(autoincrement())
  reference       String    @unique
  title           String?   // Added title
  shortDescription String?  // Added short description
  status          AnnounceStatus
  type            TransactionType
  price           Float     // mapped from 'amount'
  priceUnit       String?   // DA, MILLION, MILLIARD
  priceType       String?   // FIXED, NEGOTIABLE
  exclusive       Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  refreshDate     DateTime?
  expirationDate  DateTime? // mapped from 'expiredDate'
  featuredFrom    DateTime? // publicité accueil: début
  featuredUntil   DateTime? // publicité accueil: fin

  nbViews         Int       @default(0) // Clics sur l'annonce (incrémenté à chaque consultation)
  nbFavs          Int       @default(0)
  nbCalls         Int       @default(0) // Clics sur le bouton d'appel

  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  property        Property?
  pointUsages     PointUsage[]
  favoritedBy     Favorite[]
  messages        Message[]
  contactClicks   ContactClick[]
  reports         Report[]
  views           AnnounceView[]

  @@map("announce")
}

model Property {
  id               Int       @id @default(autoincrement())
  area             Float
  nbRooms          Int?
  nbPieces         Int?
  nbFloors         Int?
  availableDate    DateTime?
  
  announceId       Int       @unique
  announce         Announce  @relation(fields: [announceId], references: [id], onDelete: Cascade)

  addressId        Int?      @unique
  address          Address?  @relation(fields: [addressId], references: [id])
  
  commune          String?   // Added field
  mapsLink         String?   // Added field
  videos           String?   @db.Text // JSON string of video paths
  coverVideoIndex  Int?      // Index dans `videos` de la vidéo choisie comme couverture (sinon la couverture est la photo Image.isMain)

  images           Image[]
  propertyType     String?   // Simplified for now, could be a relation
  amenities        String?   @db.Text // JSON string of selected amenities IDs

  // --- New Fields for Villa Rental ---
  
  // Surfaces & Config
  landArea         Float?    // Surface Totale Terrain
  builtArea        Float?    // Surface Bâtie
  typology         String?   // F2, F3...
  configuration    String?   // R+1, R+2...
  state            String?   // Neuf, Rénové, Bon état...
  facadesCount     Int?
  acceptsBankCredit String?
  legalDocuments   String?   @db.Text // JSON array string
  
  // Parking
  parkingCount     Int?      // Garage fermé
  outdoorParking   Int?      // Espace ouvert

  // Lifestyle
  usageType        String?   // Communicante / Séparé
  cadreModeVie     String?   // Résidence fermée/Promotion, Quartier résidentiel/Standing, Quartier classique

  // Spaces
  nbSuites         Int?
  nbLivingRooms    Int?
  nbBathrooms      Int?
  bathroomType     String?
  nbToilets        Int?

  // Kitchen
  kitchenType      String?   // Américaine, Fermée...
  kitchenState     String?   // Équipée, Aménagée...

  // Tech & Comfort
  heatingType      String?   // Centralisé, Sol, Gaz...
  acType           String?   // Centralisé, Splits, Sans...
  
  // Counters (Individual / Shared)
  waterCounter     String?
  elecCounter      String?
  gasCounter       String?

  // Rental Conditions
  depositMonths    Int?      // Caution
  rentalUsage      String?   // Habitation / Pro
  chargesIncluded  Boolean   @default(false)

  // Cross-category publication
  acceptsCrossUsage    Boolean @default(false)
  crossRealEstateType  String? // Catégorie miroir (RESIDENTIEL <-> BUREAUX_COMMERCES)
  
  // Contacts
  contacts         String?   @db.Text // JSON string: [{ phone: string, whatsapp: boolean, viber: boolean }]

  @@map("property")
}

model Image {
  id          Int      @id @default(autoincrement())
  url         String?  // If stored externally
  content     Bytes?   // If stored as BLOB (like in Java)
  contentType String?
  isMain      Boolean  @default(false)
  category    String?  // "kitchen", "exterior", "bedroom", etc.
  
  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("image")
}

// --- Features ---

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  @@unique([userId, announceId])
  @@map("favorite")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  senderId  Int
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  announceId Int?
  announce   Announce? @relation(fields: [announceId], references: [id], onDelete: SetNull)

  @@map("message")
}

// Notification interne à l'utilisateur (cloche du profil) — créée automatiquement par d'autres
// services (nouveau message reçu, recherche confiée qui correspond à une de vos annonces,
// annonce validée/rejetée par l'admin, points bientôt expirés...). `link` pointe vers la page
// pertinente côté front (ex. /profile/messages, /announces/123).
model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // MESSAGE | RESEARCH_MATCH | ANNOUNCE_VALIDATED | ANNOUNCE_REJECTED | POINTS_EXPIRING
  title     String
  body      String?  @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notification")
}

// Clic sur un moyen de contact — bouton d'appel/WhatsApp/Telegram/Viber/email d'une annonce,
// ou bouton de contact de la boutique elle-même (announceId alors null). Matière première des
// statistiques "Mes statistiques" (particulier et professionnel).
model ContactClick {
  id         Int            @id @default(autoincrement())
  channel    ContactChannel
  createdAt  DateTime       @default(now())

  announceId Int?
  announce   Announce?      @relation(fields: [announceId], references: [id], onDelete: Cascade)

  // Propriétaire de l'annonce (ou de la boutique) — dénormalisé pour agréger vite par utilisateur
  // sans dépendre d'une jointure via announce (nécessaire pour les clics au niveau boutique).
  ownerId    Int
  owner      User           @relation("ContactClickOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("contact_click")
}

// Vue datée d'une annonce (une ligne par consultation de la fiche détail) — permet de tracer
// l'évolution réelle des consultations dans le temps pour les graphiques de "Mes statistiques".
// Announce.nbViews reste le compteur cumulé (rapide, affiché partout) ; cette table sert
// uniquement à reconstituer un historique par période.
model AnnounceView {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  ownerId    Int
  owner      User     @relation("AnnounceViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("announce_view")
}

// Signalement d'une annonce (bouton "Signaler un problème"). Compte réel dans les statistiques
// du propriétaire de l'annonce signalée.
model Report {
  id         Int      @id @default(autoincrement())
  reason     String
  message    String?  @db.Text
  createdAt  DateTime @default(now())

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  ownerId    Int
  owner      User     @relation("ReportedOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  reporterId Int?
  reporter   User?    @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@map("report")
}

// --- Enums ---

enum ContactChannel {
  CALL
  WHATSAPP
  TELEGRAM
  VIBER
  EMAIL
}

enum AnnounceStatus {
  DRAFT
  WAITING_VALIDATION
  VALIDATED
  ARCHIVED
  REJECTED
}

enum TransactionType {
  RENTAL
  SALE
  HOLIDAY_RENTAL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserType {
  PARTICULIER
  SOCIETE
  ADMIN
}

// Sous-catégorie des partenaires affichés sur le site (page "Partenaires")
enum PartnerCategory {
  IMMOBILIER
  HOTELLERIE
  EVENEMENTIEL
  ENTREPOSAGE
}

enum CompanyActivity {
  AGENCE_IMMOBILIERE
  PROMOTEUR_IMMOBILIER
  HOTELLERIE_HEBERGEMENT
  SALLE_DES_FETES
  ENTREPOSAGE_FRIGORIFIQUE
  ENTREPOSAGE_NON_FRIGORIFIQUE
  ADMINISTRATEUR_BIENS
  AUTRES_PROFESSIONNELS
  HOTEL
  COMPLEXE_TOURISTIQUE
  VILLAGE_VACANCES
  APPART_HOTEL
  RESIDENCE_HOTELIERE
  MOTEL
  RELAIS_ROUTIER
  CAMPING_TOURISTIQUE
  AUTRES_STRUCTURES
  SALLES_DINATOIRES
  SALLE_FORMATION
  SALLE_CONFERENCE
  AUTRES_EVENEMENTIEL
  AUTRES_ENTREPOSAGE_STOCKAGE
}

enum Civility {
  M
  MME
}

// --- New Models for Migration ---

model Contact {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  subject       String
  message       String   @db.Text
  motif         String   @default("GENERAL") // COMMERCIAL | JURIDIQUE | TECHNIQUE | GENERAL
  attachmentUrl String?
  createdAt     DateTime @default(now())
  status        String?  @default("NEW") // NEW, READ, ARCHIVED

  @@map("contact")
}

model EntrustedResearch {
  id               Int             @id @default(autoincrement())
  transaction      TransactionType
  
  // Property Criteria
  minSurface       Float?
  maxSurface       Float?
  nbPieces         Int?
  nbRooms          Int?
  nbFloors         Int?
  
  // Budget & Location
  minBudget        Float
  maxBudget        Float
  installationDate DateTime
  
  cityId           Int?
  towns            String? // Store as JSON array of Town IDs or names
  
  comment          String  @db.Text
  
  // User Info
  userId           Int?
  user             User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Additional Info
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  address          String?
  companyName      String?
  activity         String?
  
  // Property Types & Amenities
  realEstateType   String?
   propertyType     String?
  amenities        String? @db.Text // JSON string of amenities IDs

  createdAt        DateTime @default(now())

  @@map("entrusted_research")
}

// --- Contenu du site (géré depuis l'administration) ---

model SiteSetting {
  key       String   @id // ex: CONTACT_PHONE, CONTACT_EMAIL, CONTACT_ADDRESS, SUPPORT_CONTENT
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

model LegalSection {
  id        Int      @id @default(autoincrement())
  page      String   // 'CGU' | 'CONFIDENTIALITE' | 'A_PROPOS'
  title     String
  body      String   @db.Text // HTML enrichi (éditeur riche admin)
  imageUrl  String?  // image d'illustration de la section (ex. page "Qui sommes-nous ?")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_section")
}

// Liens Utiles : affichés automatiquement dans le footer du site public, gérés depuis
// l'administration (Contenu du site). Un simple couple titre/URL, ordonnable.
model UsefulLink {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("useful_link")
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_item")
}

// Diapositives du hero de la page d'accueil, gérées depuis l'administration. `categoryId`
// référence un id de REAL_ESTATE_CATEGORIES côté frontend (ex. "RESIDENTIEL") — pas de FK stricte,
// c'est un simple tag utilisé pour réutiliser le libellé/icône déjà définis pour ce domaine.
model HeroSlide {
  id         Int      @id @default(autoincrement())
  categoryId String?
  imageUrl   String
  title      String?
  subtitle   String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hero_slide")
}

model Partner {
  id          Int              @id @default(autoincrement())
  name        String
  logoUrl     String?
  websiteUrl  String?
  category    PartnerCategory?
  subCategory CompanyActivity? // sous-catégorie : même nomenclature que l'inscription pro / dépôt d'annonce
  order       Int              @default(0)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("partner")
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Candidature reçue depuis le bouton "Devenir partenaire" de la page publique /partenaires.
// Étudiée et validée depuis le dashboard admin ; l'approbation crée automatiquement un Partner publié.
model PartnerApplication {
  id          Int                       @id @default(autoincrement())
  companyName String
  contactName String
  email       String
  phone       String
  category    PartnerCategory?
  subCategory CompanyActivity?
  websiteUrl  String?
  message     String?                   @db.Text
  logoUrl     String?
  status      PartnerApplicationStatus  @default(PENDING)
  adminNote   String?                   @db.Text
  createdAt   DateTime                  @default(now())
  reviewedAt  DateTime?

  @@map("partner_application")
}
