// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Users & Auth ---

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  activated     Boolean   @default(false)
  langKey       String?
  imageUrl      String?
  activationKey String?
  resetKey      String?
  resetDate     DateTime?
  
  // Contact Info
  phone         String?
  landline      String? // Fixed phone
  address       String? // Full address text
  
  // Personal Info (Particulier)
  civility      Civility?
  dateOfBirth   DateTime?

  // Company / Professional Info
  userType      UserType  @default(PARTICULIER)
  companyName   String?
  companyActivity CompanyActivity?
  commercialRegister String?
  nif                String? // Numéro d'Identification Fiscale
  nis                String? // Numéro d'Identification Statistique

  // Documents (Société)
  rcDocumentUrl      String?
  agreementDocumentUrl String?
  nifDocumentUrl     String?
  nisDocumentUrl     String?
  inapiDocumentUrl   String? // Justificatif de dépôt INAPI (si le nom de marque n'apparaît pas sur le RC)
  agencyLogoUrl      String?
  position           String?

  // Conformité & statut de compte
  agreementExpiryDate DateTime? // Désactivation automatique des services pro à cette date
  adminVerified Boolean   @default(false)
  accountStatus AccountStatus @default(ACTIVE)
  statusReason  String?
  lastLoginAt   DateTime?

  townId        Int?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  announces     Announce[]
  entrustedResearch EntrustedResearch[]
  points        UserPoint?
  pointUsages   PointUsage[]
  pointPurchases PointPurchase[]
  boutiqueSubscriptions BoutiqueSubscription[]
  favorites     Favorite[]
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")

  @@map("user")
}

model UserPoint {
  id             Int      @id @default(autoincrement())
  currentPoints  Int      @default(0)
  expirationDate DateTime?
  
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_point")
}

model PointUsage {
  id         Int      @id @default(autoincrement())
  pointsUsed Int
  usageDate  DateTime @default(now())
  action     String   @default("BOOST") // BOOST | FEATURE

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  @@map("point_usage")
}

model PointPurchase {
  id          Int       @id @default(autoincrement())
  pack        String    // PACK_50 | PACK_100 | PACK_200
  points      Int       // 50 | 100 | 200
  price       Int       // 1500 | 2500 | 3500
  status      String    @default("PENDING") // PENDING | VALIDATED | REJECTED
  createdAt   DateTime  @default(now())
  validatedAt DateTime?

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_purchase")
}

model BoutiqueSubscription {
  id             Int       @id @default(autoincrement())
  pack           String    // STANDARD | AVANCEE | ENTREPRISE
  price          Int       // 5000 | 10000 | 15000
  pointsIncluded Int       // 50 | 100 | 200
  status         String    @default("PENDING") // PENDING | VALIDATED | REJECTED
  createdAt      DateTime  @default(now())
  validatedAt    DateTime?
  expiresAt      DateTime? // date d'expiration des points (1 mois)

  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("boutique_subscription")
}

// --- Locations (City / Town / Address) ---

model City {
  id      Int    @id @default(autoincrement())
  nameAr  String
  nameEn  String
  nameFr  String
  code    Int?   @unique
  
  towns   Town[]

  @@map("city")
}

model Town {
  id      Int    @id @default(autoincrement())
  nameAr  String
  nameEn  String
  nameFr  String
  code    Int?   @unique
  
  cityId  Int
  city    City   @relation(fields: [cityId], references: [id])
  
  addresses Address[]

  @@map("town")
}

model Address {
  id      Int    @id @default(autoincrement())
  street  String // mapped from 'adress' in Java
  
  townId  Int
  town    Town   @relation(fields: [townId], references: [id])

  property Property?

  @@map("address")
}

// --- Real Estate Core ---

model Announce {
  id              Int       @id @default(autoincrement())
  reference       String    @unique
  title           String?   // Added title
  shortDescription String?  // Added short description
  status          AnnounceStatus
  type            TransactionType
  price           Float     // mapped from 'amount'
  priceUnit       String?   // DA, MILLION, MILLIARD
  priceType       String?   // FIXED, NEGOTIABLE
  exclusive       Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  refreshDate     DateTime?
  expirationDate  DateTime? // mapped from 'expiredDate'
  featuredFrom    DateTime? // publicité accueil: début
  featuredUntil   DateTime? // publicité accueil: fin

  nbViews         Int       @default(0) // Clics sur l'annonce (incrémenté à chaque consultation)
  nbFavs          Int       @default(0)
  nbCalls         Int       @default(0) // Clics sur le bouton d'appel

  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  property        Property?
  pointUsages     PointUsage[]
  favoritedBy     Favorite[]
  messages        Message[]

  @@map("announce")
}

model Property {
  id               Int       @id @default(autoincrement())
  area             Float
  nbRooms          Int?
  nbPieces         Int?
  nbFloors         Int?
  availableDate    DateTime?
  
  announceId       Int       @unique
  announce         Announce  @relation(fields: [announceId], references: [id], onDelete: Cascade)

  addressId        Int?      @unique
  address          Address?  @relation(fields: [addressId], references: [id])
  
  commune          String?   // Added field
  mapsLink         String?   // Added field
  videos           String?   @db.Text // JSON string of video paths

  images           Image[]
  propertyType     String?   // Simplified for now, could be a relation
  amenities        String?   @db.Text // JSON string of selected amenities IDs

  // --- New Fields for Villa Rental ---
  
  // Surfaces & Config
  landArea         Float?    // Surface Totale Terrain
  builtArea        Float?    // Surface Bâtie
  typology         String?   // F2, F3...
  configuration    String?   // R+1, R+2...
  state            String?   // Neuf, Rénové, Bon état...
  facadesCount     Int?
  acceptsBankCredit String?
  legalDocuments   String?   @db.Text // JSON array string
  
  // Parking
  parkingCount     Int?      // Garage fermé
  outdoorParking   Int?      // Espace ouvert

  // Lifestyle
  usageType        String?   // Communicante / Séparé
  cadreModeVie     String?   // Résidence fermée/Promotion, Quartier résidentiel/Standing, Quartier classique

  // Spaces
  nbSuites         Int?
  nbLivingRooms    Int?
  nbBathrooms      Int?
  bathroomType     String?
  nbToilets        Int?

  // Kitchen
  kitchenType      String?   // Américaine, Fermée...
  kitchenState     String?   // Équipée, Aménagée...

  // Tech & Comfort
  heatingType      String?   // Centralisé, Sol, Gaz...
  acType           String?   // Centralisé, Splits, Sans...
  
  // Counters (Individual / Shared)
  waterCounter     String?
  elecCounter      String?
  gasCounter       String?

  // Rental Conditions
  depositMonths    Int?      // Caution
  rentalUsage      String?   // Habitation / Pro
  chargesIncluded  Boolean   @default(false)

  // Cross-category publication
  acceptsCrossUsage    Boolean @default(false)
  crossRealEstateType  String? // Catégorie miroir (RESIDENTIEL <-> BUREAUX_COMMERCES)
  
  // Contacts
  contacts         String?   @db.Text // JSON string: [{ phone: string, whatsapp: boolean, viber: boolean }]

  @@map("property")
}

model Image {
  id          Int      @id @default(autoincrement())
  url         String?  // If stored externally
  content     Bytes?   // If stored as BLOB (like in Java)
  contentType String?
  isMain      Boolean  @default(false)
  category    String?  // "kitchen", "exterior", "bedroom", etc.
  
  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("image")
}

// --- Features ---

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announceId Int
  announce   Announce @relation(fields: [announceId], references: [id], onDelete: Cascade)

  @@unique([userId, announceId])
  @@map("favorite")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  senderId  Int
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  announceId Int?
  announce   Announce? @relation(fields: [announceId], references: [id], onDelete: SetNull)

  @@map("message")
}

// --- Enums ---

enum AnnounceStatus {
  DRAFT
  WAITING_VALIDATION
  VALIDATED
  ARCHIVED
  REJECTED
}

enum TransactionType {
  RENTAL
  SALE
  HOLIDAY_RENTAL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserType {
  PARTICULIER
  SOCIETE
  ADMIN
}

// Sous-catégorie des partenaires affichés sur le site (page "Partenaires")
enum PartnerCategory {
  IMMOBILIER
  HOTELLERIE
  EVENEMENTIEL
  ENTREPOSAGE
}

enum CompanyActivity {
  AGENCE_IMMOBILIERE
  PROMOTEUR_IMMOBILIER
  HOTELLERIE_HEBERGEMENT
  SALLE_DES_FETES
  ENTREPOSAGE_FRIGORIFIQUE
  ENTREPOSAGE_NON_FRIGORIFIQUE
  ADMINISTRATEUR_BIENS
  AUTRES_PROFESSIONNELS
  HOTEL
  COMPLEXE_TOURISTIQUE
  VILLAGE_VACANCES
  APPART_HOTEL
  RESIDENCE_HOTELIERE
  MOTEL
  RELAIS_ROUTIER
  CAMPING_TOURISTIQUE
  AUTRES_STRUCTURES
  SALLES_DINATOIRES
  SALLE_FORMATION
  SALLE_CONFERENCE
  AUTRES_EVENEMENTIEL
  AUTRES_ENTREPOSAGE_STOCKAGE
}

enum Civility {
  M
  MME
}

// --- New Models for Migration ---

model Contact {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  subject       String
  message       String   @db.Text
  motif         String   @default("GENERAL") // COMMERCIAL | JURIDIQUE | TECHNIQUE | GENERAL
  attachmentUrl String?
  createdAt     DateTime @default(now())
  status        String?  @default("NEW") // NEW, READ, ARCHIVED

  @@map("contact")
}

model EntrustedResearch {
  id               Int             @id @default(autoincrement())
  transaction      TransactionType
  
  // Property Criteria
  minSurface       Float?
  maxSurface       Float?
  nbPieces         Int?
  nbRooms          Int?
  nbFloors         Int?
  
  // Budget & Location
  minBudget        Float
  maxBudget        Float
  installationDate DateTime
  
  cityId           Int?
  towns            String? // Store as JSON array of Town IDs or names
  
  comment          String  @db.Text
  
  // User Info
  userId           Int?
  user             User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Additional Info
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  address          String?
  companyName      String?
  activity         String?
  
  // Property Types & Amenities
  realEstateType   String?
   propertyType     String?
  amenities        String? @db.Text // JSON string of amenities IDs

  createdAt        DateTime @default(now())

  @@map("entrusted_research")
}

// --- Contenu du site (géré depuis l'administration) ---

model SiteSetting {
  key       String   @id // ex: CONTACT_PHONE, CONTACT_EMAIL, CONTACT_ADDRESS, SUPPORT_CONTENT
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

model LegalSection {
  id        Int      @id @default(autoincrement())
  page      String   // 'CGU' | 'CONFIDENTIALITE'
  title     String
  body      String   @db.Text // HTML enrichi (éditeur riche admin)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_section")
}

model FaqItem {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_item")
}

model Partner {
  id          Int              @id @default(autoincrement())
  name        String
  logoUrl     String?
  websiteUrl  String?
  category    PartnerCategory?
  subCategory CompanyActivity? // sous-catégorie : même nomenclature que l'inscription pro / dépôt d'annonce
  order       Int              @default(0)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("partner")
}
